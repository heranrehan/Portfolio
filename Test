<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Raihan - Visual Merchandiser & Interior Designer</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            line-height: 1.6;
            color: #1d1d1d;
            background: #ffffff;
        }

        body.dark-mode {
            background: #0a0a0a;
            color: #f5f5f5;
        }

        :root {
            --primary: #0057AD;
            --accent: #FBDA0C;
        }

        /* Scrolling Announcement Banner */
        .announcement-banner {
            background: #f0f0f0;
            padding: 0.75rem 0;
            overflow: hidden;
            border-bottom: 1px solid #e0e0e0;
        }

        body.dark-mode .announcement-banner {
            background: #1a1a1a;
            border-bottom-color: #333;
        }

        .announcement-scroll {
            display: flex;
            animation: scroll 15s linear infinite;
            white-space: nowrap;
            gap: 2rem;
        }

        .announcement-item {
            font-size: 0.85rem;
            font-weight: 500;
            color: #666;
        }

        body.dark-mode .announcement-item {
            color: #aaa;
        }

        @keyframes scroll {
            0% {
                transform: translateX(100%);
            }
            100% {
                transform: translateX(-100%);
            }
        }

        /* Header */
        header {
            padding: 1.5rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(0, 0, 0, 0.08);
            z-index: 100;
        }

        body.dark-mode header {
            background: rgba(10, 10, 10, 0.98);
            border-bottom-color: rgba(255, 255, 255, 0.1);
        }

        .logo {
            font-size: 1.1rem;
            font-weight: 700;
            letter-spacing: -0.5px;
        }

        nav ul {
            display: flex;
            gap: 2.5rem;
            list-style: none;
        }

        nav a {
            text-decoration: none;
            color: #1d1d1d;
            font-size: 0.9rem;
            font-weight: 500;
            transition: color 0.2s;
        }

        body.dark-mode nav a {
            color: #f5f5f5;
        }

        nav a:hover {
            color: var(--primary);
        }

        .theme-toggle {
            background: none;
            border: none;
            font-size: 1rem;
            cursor: pointer;
            opacity: 0.7;
            transition: opacity 0.2s;
        }

        .theme-toggle:hover {
            opacity: 1;
        }

        /* Hero Section */
        .hero {
            padding: 8rem 2rem 4rem;
            max-width: 1400px;
            margin: 0;
            text-align: left;
        }

        .hero h1 {
            font-size: 5.5rem;
            font-weight: 700;
            line-height: 1.1;
            margin-bottom: 2rem;
            letter-spacing: -0.02em;
        }

        .hero .subtitle {
            font-size: 1.25rem;
            color: #666;
            max-width: 800px;
            margin: 0 0 3rem 0;
            line-height: 1.6;
        }

        body.dark-mode .hero .subtitle {
            color: #aaa;
        }

        /* Section */
        section {
            padding: 5rem 2rem;
            max-width: 1400px;
            margin: 0;
        }

        .section-header {
            display: flex;
            align-items: baseline;
            gap: 2rem;
            margin-bottom: 3rem;
        }

        .section-number {
            font-size: 3.5rem;
            font-weight: 700;
            color: var(--accent);
            min-width: 120px;
            line-height: 1;
        }

        .section-header h2 {
            font-size: 2.5rem;
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        body.dark-mode .section-header h2 {
            color: #f5f5f5;
        }

        /* Portfolio Grid */
        .portfolio-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 3rem;
            margin-bottom: 2rem;
        }

        .portfolio-item {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2.5rem;
            align-items: center;
        }

        .portfolio-item:nth-child(even) {
            grid-template-columns: 1fr 1fr;
            direction: rtl;
        }

        .portfolio-item:nth-child(even) > * {
            direction: ltr;
        }

        .portfolio-image {
            width: 100%;
            height: 400px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1rem;
            text-align: center;
            padding: 2rem;
        }

        .portfolio-content h3 {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 1rem;
            letter-spacing: -0.015em;
        }

        .portfolio-content .category {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: var(--primary);
            font-weight: 600;
            margin-bottom: 1rem;
        }

        .portfolio-content p {
            font-size: 1rem;
            line-height: 1.8;
            color: #555;
            margin-bottom: 1.5rem;
        }

        body.dark-mode .portfolio-content p {
            color: #aaa;
        }

        .portfolio-content a {
            color: var(--primary);
            text-decoration: none;
            font-weight: 600;
            transition: opacity 0.2s;
        }

        .portfolio-content a:hover {
            opacity: 0.7;
        }

        /* Skills / Expertise */
        .expertise-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 2rem;
            margin-top: 3rem;
        }

        .expertise-card {
            padding: 2.5rem;
            background: #f9f9f9;
            border-radius: 8px;
            transition: all 0.3s;
        }

        body.dark-mode .expertise-card {
            background: #1a1a1a;
        }

        .expertise-card:hover {
            transform: translateY(-4px);
        }

        .expertise-card h3 {
            font-size: 1.25rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            color: var(--primary);
        }

        .expertise-card ul {
            list-style: none;
        }

        .expertise-card li {
            padding: 0.5rem 0;
            color: #555;
            font-size: 0.95rem;
        }

        body.dark-mode .expertise-card li {
            color: #aaa;
        }

        .expertise-card li:before {
            content: "→ ";
            color: var(--primary);
            margin-right: 0.5rem;
            font-weight: 600;
        }

        /* Experience */
        .experience-item {
            margin-bottom: 2.5rem;
            padding-bottom: 2.5rem;
            border-bottom: 1px solid #e0e0e0;
        }

        body.dark-mode .experience-item {
            border-bottom-color: #333;
        }

        .experience-item:last-child {
            border-bottom: none;
        }

        .experience-item h3 {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .experience-item .position {
            font-size: 0.85rem;
            color: var(--primary);
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 0.1em;
            margin-bottom: 1rem;
        }

        .experience-item p {
            color: #555;
            line-height: 1.8;
            font-size: 0.95rem;
        }

        body.dark-mode .experience-item p {
            color: #aaa;
        }

        /* Contact */
        .contact-section {
            background: var(--primary);
            color: white;
            padding: 4rem 2rem;
            text-align: center;
            border-radius: 8px;
            margin-top: 3rem;
        }

        .contact-section h2 {
            font-size: 2.5rem;
            margin-bottom: 1rem;
        }

        .contact-section p {
            font-size: 1.1rem;
            margin-bottom: 2.5rem;
            opacity: 0.95;
        }

        .contact-links {
            display: flex;
            justify-content: center;
            gap: 2rem;
            flex-wrap: wrap;
            margin-top: 2rem;
        }

        .contact-links a {
            color: var(--accent);
            text-decoration: none;
            font-weight: 600;
            transition: opacity 0.2s;
        }

        .contact-links a:hover {
            opacity: 0.8;
        }

        /* Footer */
        footer {
            text-align: center;
            padding: 2rem;
            color: #666;
            font-size: 0.85rem;
            border-top: 1px solid #e0e0e0;
        }

        body.dark-mode footer {
            color: #999;
            border-top-color: #333;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .hero h1 {
                font-size: 2.5rem;
            }

            .hero .subtitle {
                font-size: 1rem;
            }

            .section-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 1rem;
            }

            .portfolio-item,
            .portfolio-item:nth-child(even) {
                grid-template-columns: 1fr;
                direction: ltr;
            }

            .portfolio-item:nth-child(even) > * {
                direction: ltr;
            }

            .portfolio-image {
                height: 300px;
            }

            nav ul {
                display: none;
            }

            .section-header h2 {
                font-size: 1.75rem;
            }

            .contact-links {
                flex-direction: column;
                gap: 1rem;
            }
        }
    </style>
</head>
